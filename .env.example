# Copy to .env for local overrides. Never commit .env.
# Nested configuration keys use a double underscore.
TRADING__LOGGING__LEVEL=INFO
TRADING__EXECUTION__MODE=disabled

# Reserved for a future broker adapter. Keep real credentials only in .env
# or an OS credential store; the current scaffold does not load or use them.
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
